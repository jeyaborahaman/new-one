{
  "name": "jeyabo-api",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex --knexfile src/db/knexfile.js migrate:latest",
    "rollback": "knex --knexfile src/db/knexfile.js migrate:rollback",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agora-token": "^2.0.6",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0"
  }
}
